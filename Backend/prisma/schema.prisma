generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

model User {
  id         Int      @id @default(autoincrement())
  fullName   String
  phone      String   @unique
  password   String
  role       UserRole @default(CUSTOMER)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // request with relation
  requests   ServiceRequest[] @relation("UserRequests")

  // messaging relation
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // new technician with work relation
  technicianJobs   ServiceRequest[] @relation("TechnicianRequests")
}

// Service Category (types of ServiceRequest)
model ServiceCategory {
  id          Int               @id @default(autoincrement())
  name        String
  key         String            @unique
  requests    ServiceRequest[]  @relation("CategoryRequests")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// Service Request (request table)
model ServiceRequest {
  id           Int           @id @default(autoincrement())
  customerId   Int
  categoryId   Int
  description  String
  location     String
  status       RequestStatus @default(PENDING)
  technicianId Int?
  
  // relation
  customer    User            @relation("UserRequests", fields: [customerId], references: [id])
  category    ServiceCategory @relation("CategoryRequests", fields: [categoryId], references: [id])
  technician  User?           @relation("TechnicianRequests", fields: [technicianId], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// request status 
enum RequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Messaging Model 
model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}